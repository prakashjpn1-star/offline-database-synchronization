{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/offline-database-synchronization/schemas/record.schema.json",
  "title": "Equipment record",
  "type": "object",
  "properties": {
    "recordId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "quantity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  },
  "required": [
    "recordId",
    "label",
    "category",
    "quantity"
  ],
  "additionalProperties": false
}
