{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/offline-database-synchronization/schemas/change-page.schema.json",
  "title": "Consecutive accepted feed page",
  "type": "object",
  "properties": {
    "sourceGeneration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "afterSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nextCheckpoint": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "highWaterMark": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "kind": {
            "enum": [
              "CREATE",
              "UPDATE",
              "DELETE",
              "RESTORE",
              "RESOLUTION"
            ]
          },
          "operationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "state": {
            "type": "object",
            "properties": {
              "recordId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "deleted": {
                "type": "boolean"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "category": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      }
                    },
                    "required": [
                      "label",
                      "category",
                      "quantity"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "recordId",
              "revision",
              "deleted",
              "value"
            ],
            "additionalProperties": false
          },
          "conflictId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "resolvedOperationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "sequence",
          "kind",
          "operationId",
          "state"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "sourceGeneration",
    "afterSequence",
    "nextCheckpoint",
    "highWaterMark",
    "entries"
  ],
  "additionalProperties": false
}
