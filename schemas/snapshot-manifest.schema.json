{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/offline-database-synchronization/schemas/snapshot-manifest.schema.json",
  "title": "Consistent snapshot manifest",
  "type": "object",
  "properties": {
    "snapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sourceGeneration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "schemaVersion": {
      "const": 1
    },
    "throughSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "recordCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tombstoneCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "canonicalDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "formatVersion": {
      "const": 1
    }
  },
  "required": [
    "snapshotId",
    "sourceGeneration",
    "schemaVersion",
    "throughSequence",
    "recordCount",
    "tombstoneCount",
    "canonicalDigest",
    "formatVersion"
  ],
  "additionalProperties": false
}
